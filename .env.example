# ═══════════════════════════════════════════════════════════════
# Acronis VM Monitor — Variables de Entorno
# Copia este archivo como .env y completa tus credenciales.
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Credenciales Acronis ────────────────────────────────────────
ACRONIS_CLIENT_ID=TU_CLIENT_ID_AQUI
ACRONIS_CLIENT_SECRET=TU_CLIENT_SECRET_AQUI
ACRONIS_DC_URL=https://us5-cloud.acronis.com

# ── Monitor ─────────────────────────────────────────────────────
# Intervalo de consulta a la API (segundos). Mínimo recomendado: 300
POLLING_INTERVAL_SECONDS=300

# Score mínimo aceptable de CyberFit (0-850). Bajo esto = alerta
CYBERFIT_THRESHOLD=500

# IDs de VMs a monitorear (separados por coma). Vacío = TODAS
SELECTED_VM_IDS=

# ── API / Dashboard ─────────────────────────────────────────────
API_PORT=8085
API_HOST=0.0.0.0

# ── Notificaciones Telegram ─────────────────────────────────────
# Obtén el token creando un bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=
# ID del chat o grupo destino. Múltiples separados por coma:
# TELEGRAM_CHAT_ID=-1001234567890,-987654321
TELEGRAM_CHAT_ID=

# ── Motor de notificaciones ─────────────────────────────────────
# Cada cuántos segundos evalúa las reglas (independiente del monitor)
NOTIFY_INTERVAL_SECONDS=300
# Re-notificar si la condición sigue activa pasadas N horas
REMIND_INTERVAL_H=6
# Umbrales para alertas de backup
NOTIFY_BACKUP_HOURS=25
NOTIFY_BACKUP_CRIT_HOURS=48
# Activar consulta a la API nativa de alertas de Acronis
ACRONIS_ALERTS_ENABLED=true
# Modo prueba: no envía mensajes reales pero muestra qué enviaría
DRY_RUN=false

# ── Docker ─────────────────────────────────────────────────────
# Directorio de datos compartido entre contenedores
# (no cambiar si usas docker-compose)
DATA_DIR=/app/data
